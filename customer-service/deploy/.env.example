# dshagent 客服系统 — 环境变量示例
# 复制为 .env 后填写真实值：cp .env.example .env

# ── 对外端口 ────────────────────────────────────────────────────────────────
GUEST_PORT=10800
ADMIN_PORT=10801

# ── 模型路由（客服默认 provider；key 由 llm-pi-ai 静态配置读取）────────────
# 本地 LLM 中转（LiteLLM 网关，宿主 127.0.0.1:4000）的 master key。
# 网关把 Command Code / AgentRouter / NooCool 多上游聚合为一个 OpenAI 兼容
# 端点并自动故障转移；profile 里以 provider `litellm` 接入。容器按名访问
# http://llm-gateway:4000（共享 llm-shared 网络，由 `llm-gateway start` 建）。
# 不接本地网关时留空即可——客服系统会退回下面的直连 provider。
LITELLM_MASTER_KEY=

CMD_API_KEY_2=
# AgentRouter 本地网关（若容器可达）：
AGENTROUTER_API_KEY=
# 其它可选 OpenAI 兼容 provider：
NOOCOOL_API_KEY=
CMD_API_KEY=

# ── 知识库（Obsidian vault 目录，只读挂载为容器 /kb）──────────────────────
# 指向宿主机上 Obsidian 的 vault 文件夹；编辑 vault 即更新客服知识
KB_VAULT_DIR=./kb
