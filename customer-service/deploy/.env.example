# dshagent 客服系统 — 环境变量示例
# 复制为 .env 后填写真实值：cp .env.example .env

# ── 对外端口 ────────────────────────────────────────────────────────────────
HTTP_PORT=8080

# ── 模型路由（客服默认 provider；key 由 llm-pi-ai 静态配置读取）────────────
# 开箱默认 provider = commandcode（公网 OpenAI 兼容端点，profile 已配）。
# 部署时填你自己的 key；也可改 profile/cordis.patch.yml 换 agentrouter 等。
CMD_API_KEY_2=
# AgentRouter 本地网关（若容器可达）：
AGENTROUTER_API_KEY=
# 其它可选 OpenAI 兼容 provider：
NOOCOOL_API_KEY=
CMD_API_KEY=

# ── 知识库（Obsidian vault 目录，只读挂载为容器 /kb）──────────────────────
# 指向宿主机上 Obsidian 的 vault 文件夹；编辑 vault 即更新客服知识
KB_VAULT_DIR=./kb
